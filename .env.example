APP_VERSION=1.0.0-rc1
APP_ENVIRONMENT=production
API_DOCS_ENABLED=false
DEBUG=false
DATABASE_URL=postgresql+asyncpg://cap:replace-me@postgres:5432/cap
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-a-different-32-character-secret
LOG_LEVEL=INFO
CAP_ZAP_API_KEY=replace-with-a-long-random-zap-api-key
POSTGRES_DB=cap
POSTGRES_USER=cap
POSTGRES_PASSWORD=replace-with-a-long-random-password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password
VITE_API_BASE_URL=/api
RBAC_IDENTITY_HEADER=X-CAP-User
RBAC_TRUSTED_PROXY_HEADER=X-CAP-Proxy-Secret
RBAC_TRUSTED_PROXY_SECRET=replace-with-a-long-random-proxy-secret
CAP_DEFAULT_USER=read-only
METRICS_ENABLED=true
TRACING_ENABLED=true
OTEL_SERVICE_NAME=cyber-agent-platform
OTEL_EXPORTER_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Phase 28.4: production isolation + durable object storage (no real creds)
SANDBOX_PROVIDER=subprocess-sandbox
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=512
SANDBOX_MAX_PROCESSES=64
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_ACCESS_KEY=replace-with-minio-user
OBJECT_STORE_SECRET_KEY=replace-with-minio-password
OBJECT_STORE_BUCKET=cap-evidence
OBJECT_STORE_SECURE=false
ORPHAN_GRACE_SECONDS=3600
GC_INTERVAL_SECONDS=3600
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
ACQ_METRICS_PORT=9100

# Phase 28.5: OCI container sandbox (Linux production; worker mounts docker.sock)
SANDBOX_PROVIDER=oci-sandbox
SANDBOX_IMAGE=cap-sandbox-http:latest
SANDBOX_BROWSER_IMAGE=cap-sandbox-browser:latest
SANDBOX_NETWORK=cap-sandbox-egress
SANDBOX_CPU_MILLICORES=500
SANDBOX_PIDS_LIMIT=256
EGRESS_PROXY_URL=http://egress-proxy:8080
SANDBOX_REAPER_INTERVAL_SECONDS=60
# test-only egress allowlist (host:port) for a local lab; empty in production
CAP_EGRESS_ALLOW=
